# clangd fallback when MSVC's compile_commands.json is missing.
# Prefer a Ninja compile DB under build/ if present.

CompileFlags:
  Add:
    - -std=c++20
    - -xc++
    - -DKA_HGIS_HAS_QGIS=1
    - -Isrc
    - -IC:/OSGeo4W/apps/qgis-dev/include
    - -IC:/OSGeo4W/apps/gdal-dev/include
    - -IC:/OSGeo4W/include
    - -IC:/OSGeo4W/apps/Qt6/include
    - -IC:/OSGeo4W/apps/Qt6/include/QtCore
    - -IC:/OSGeo4W/apps/Qt6/include/QtGui
    - -IC:/OSGeo4W/apps/Qt6/include/QtWidgets
    - -IC:/OSGeo4W/apps/Qt6/include/QtXml
    - -IC:/OSGeo4W/apps/Qt6/include/QtNetwork
    - -IC:/OSGeo4W/apps/Qt6/include/QtSvg
    - -IC:/OSGeo4W/apps/Qt6/include/QtPrintSupport
    - -IC:/OSGeo4W/apps/Qt6/include/QtTest
    - -ID:/OSGeo4W/apps/qgis-dev/include
    - -ID:/OSGeo4W/apps/gdal-dev/include
    - -ID:/OSGeo4W/include
    - -ID:/OSGeo4W/apps/Qt6/include
    - -ID:/OSGeo4W/apps/Qt6/include/QtCore
    - -ID:/OSGeo4W/apps/Qt6/include/QtGui
    - -ID:/OSGeo4W/apps/Qt6/include/QtWidgets
    - -ID:/OSGeo4W/apps/Qt6/include/QtXml
    - -ID:/OSGeo4W/apps/Qt6/include/QtNetwork
    - -ID:/OSGeo4W/apps/Qt6/include/QtSvg
    - -ID:/OSGeo4W/apps/Qt6/include/QtPrintSupport
    - -ID:/OSGeo4W/apps/Qt6/include/QtTest
  CompilationDatabase: build

Index:
  Background: Build

Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None

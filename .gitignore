# Portable folder: keep launchers/docs; do not commit OSGeo/Qt/QGIS DLLs.
!dist/
!dist/**/
!dist/**/*.exe
!dist/**/*.bat
!dist/**/*.ps1
!dist/**/*.txt
!dist/**/*.json
!dist/**/*.yaml
!dist/**/*.md
dist/**/*.pdb
dist/**/*.ilk
dist/**/*.dll
dist/ka-hgis-portable/apps/
dist/ka-hgis-portable/bin/
dist/ka-hgis-portable/share/

# Python / misc
__pycache__/
*.pyc
.venv/
venv/


# Local survey / QGIS project files (do not commit field data)
*.gpkg
*.qgz
!samples/**/*.gpkg

config/secrets.ini
**/secrets.ini


# QGIS offline manuals: large Desktop User Guide PDFs stay local (see docs/vendor/qgis-manual-3.44/README.md)
docs/vendor/qgis-manual-3.44/QGIS-*-DesktopUserGuide-*.pdf

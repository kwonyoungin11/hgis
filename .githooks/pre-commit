#!/bin/sh
# Refresh docs/COMMIT_STATUS.md and stage it so every commit records progress.
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 0

if command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "scripts/update-commit-status.ps1" -IncludeStagedSummary
elif command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File "scripts/update-commit-status.ps1" -IncludeStagedSummary
else
  echo "pre-commit: powershell not found; skip COMMIT_STATUS update" >&2
  exit 0
fi

if [ -f docs/COMMIT_STATUS.md ]; then
  git add docs/COMMIT_STATUS.md
fi

exit 0

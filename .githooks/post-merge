#!/bin/sh
# After pull/merge, refresh local status snapshot (may leave working tree dirty).
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 0
if command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "scripts/update-commit-status.ps1" || true
elif command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File "scripts/update-commit-status.ps1" || true
fi
exit 0

/* ka-hgis field chrome — teal + cream. SSOT: hex only; no image functions; no bare QWidget/QGraphicsView/QFrame. */

/* ---- GIS exclude (contract 1). No fill/border color here. ---- */
QgsMapCanvas, QWidget#mapCanvas, QgsLayoutView, QWidget#layoutView {
  background: none;
  border: none;
}

/* ---- Window face ---- */
QMainWindow, QDialog, QMessageBox, QInputDialog, QColorDialog {
  background: #F6F1E8;
  color: #1C1917;
  font-family: "Pretendard GOV", "Pretendard", "Malgun Gothic", "Segoe UI";
  font-size: 13px;
}

/* ---- Push buttons ---- */
QPushButton {
  color: #1C1917;
  font-weight: 600;
  min-height: 34px;
  padding: 8px 16px;
  border: 1px solid #E4DCCE;
  border-radius: 8px;
  background: #FFFFFF;
}
QPushButton:hover { background: #F6F1E8; border-color: #D6CBB8; }
QPushButton:pressed { background: #E7F5F2; }
QPushButton:checked {
  background: #E7F5F2;
  color: #0F766E;
  border-color: #0F766E;
}
QPushButton:default, QPushButton#btnAdjustDone, QPushButton.primary, QPushButton#btnPrimary {
  background: #0F766E;
  color: #FFFFFF;
  border: 1px solid #0F766E;
}
QPushButton:default:hover, QPushButton#btnAdjustDone:hover, QPushButton.primary:hover, QPushButton#btnPrimary:hover {
  background: #115E59;
}
QPushButton:disabled {
  background: #F3EEE4;
  color: #A8A29E;
  border-color: #E4DCCE;
}

/* ---- Tool buttons ---- */
QToolButton {
  color: #57534E;
  font-weight: 600;
  font-size: 11px;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  padding: 6px 10px;
}
QToolButton:hover { background: #F3EEE4; color: #1C1917; }
QToolButton:pressed { background: #E7F5F2; }
QToolButton:checked {
  background: transparent;
  color: #1C1917;
  border: 1px solid transparent;
  border-bottom: 2px solid #B45309;
}
QToolButton:disabled { color: #A8A29E; }
QToolButton#btnPrimary, QToolButton#btnFind {
  background: #0F766E;
  color: #FFFFFF;
  border: 1px solid #0F766E;
}
QToolButton#btnPrimary:hover, QToolButton#btnFind:hover {
  background: #115E59;
  color: #FFFFFF;
  border: 1px solid #115E59;
}
QToolButton#btnPrimary:checked, QToolButton#btnFind:checked {
  background: #115E59;
  color: #FFFFFF;
  border: 1px solid #115E59;
}

QToolBar {
  background: #FFFFFF;
  border: none;
  spacing: 8px;
  padding: 8px 12px;
}
QToolBar#mainToolbar, QToolBar#studioToolbar {
  border-bottom: 1px solid #E4DCCE;
}
QToolBar#studioToolbar QToolButton {
  min-height: 36px;
  padding: 6px 10px;
  font-size: 12px;
  color: #44403C;
}
QToolBar#subToolbar {
  background: #FFFcf7;
  border-top: 1px solid #E4DCCE;
  border-bottom: 1px solid #E4DCCE;
}
QToolBar#mainToolbar QToolButton {
  min-width: 52px;
  min-height: 52px;
  font-size: 11px;
}
QToolBar#studioToolRail {
  background: #FFFcf7;
  spacing: 1px;
  padding: 2px 4px;
  border: none;
  border-left: 1px solid #E4DCCE;
}
QToolBar#studioToolRail QToolButton {
  min-width: 60px;
  min-height: 40px;
  padding: 1px 2px;
  font-size: 10px;
  color: #57534E;
}
QLabel#subToolbarCaption { color: #78716C; font-weight: 600; padding: 0 8px; background: transparent; }

/* ---- Fields ---- */
QLineEdit, QComboBox, QAbstractSpinBox, QTextEdit, QPlainTextEdit {
  background: #FFFFFF;
  color: #1C1917;
  border: 1px solid #E4DCCE;
  border-radius: 8px;
  min-height: 32px;
  padding: 4px 10px;
  selection-background-color: #0F766E;
  selection-color: #FFFFFF;
}
QLineEdit:focus, QComboBox:focus, QAbstractSpinBox:focus {
  border-color: #0F766E;
}
QLineEdit:disabled, QComboBox:disabled, QAbstractSpinBox:disabled {
  background: #F6F1E8;
  color: #A8A29E;
}
QLineEdit#locationSearch { min-height: 34px; min-width: 220px; background: #FFFFFF; }

QAbstractSpinBox { padding-right: 16px; }
QAbstractSpinBox::up-button { width: 16px; }
QComboBox::drop-down {
  subcontrol-origin: border;
  width: 20px;
  border-left: 1px solid #E4DCCE;
}
QComboBox QAbstractItemView, QColorDialog QAbstractSpinBox {
  background: #FFFFFF;
  color: #1C1917;
  selection-background-color: #E7F5F2;
  selection-color: #1C1917;
  min-height: 26px;
  border: 1px solid #E4DCCE;
}

/* ---- Trees / layer list ---- */
QTreeView, QgsLayerTreeView, QListWidget {
  background: #FFFcf7;
  color: #1C1917;
  border: 1px solid #E4DCCE;
  border-radius: 8px;
  outline: none;
  font-size: 13px;
}
QTreeView::item, QgsLayerTreeView::item, QListWidget::item {
  color: #1C1917;
  padding: 5px 6px;
  min-height: 24px;
}
QTreeView::item:selected, QgsLayerTreeView::item:selected, QListWidget::item:selected {
  background: #EDE6D9;
  color: #1C1917;
}
QTreeView::item:hover, QgsLayerTreeView::item:hover, QListWidget::item:hover {
  background: #F3EEE4;
}
QHeaderView::section {
  background: #F6F1E8;
  color: #78716C;
  border: 1px solid #E4DCCE;
  padding: 6px 8px;
}

/* ---- Cards / docks / splitter ---- */
QFrame#mapCard, QFrame#layersCard, QFrame#filesCard,
QFrame#filesInner, QFrame#layersInner,
QFrame#itemInspector, QFrame#mapAdjustBar, QFrame#drawerCard,
QFrame#studioLeftCol, QFrame#studioBottomBar {
  background: #FFFcf7;
  border: 1px solid #E4DCCE;
  border-radius: 10px;
  color: #1C1917;
}
QFrame#studioLeftCol {
  border-radius: 0px;
  border: none;
  border-right: 1px solid #E4DCCE;
  background: #F6F1E8;
}
QFrame#studioBottomBar {
  border-radius: 0px;
  border: none;
  border-top: 1px solid #E4DCCE;
  background: #FFFFFF;
}
QFrame#mapCard { background: #FFFFFF; }
QWidget#sampleStrip {
  background: #FFFFFF;
  border: none;
  border-bottom: 1px solid #E4DCCE;
}
QToolButton.sampleTile {
  min-width: 56px;
  padding: 8px 10px;
}
QToolButton#scaleChip {
  min-width: 56px;
  min-height: 36px;
  font-size: 12px;
  font-weight: 700;
  color: #1C1917;
  background: #FFFFFF;
  border: 1px solid #E4DCCE;
  border-radius: 8px;
}
QToolButton#scaleChip:checked {
  background: #E7F5F2;
  color: #0F766E;
  border: 1px solid #0F766E;
}
QLabel#emptyState {
  color: #78716C;
  font-size: 13px;
  padding: 24px 16px;
  background: transparent;
}
QDockWidget { border: 1px solid #E4DCCE; color: #1C1917; titlebar-close-icon: none; }
QDockWidget::title {
  background: #F6F1E8;
  color: #1C1917;
  padding: 8px;
  border-bottom: 1px solid #E4DCCE;
}
QSplitter::handle {
  background: #E4DCCE;
  width: 1px;
  height: 1px;
}

QLabel { color: #1C1917; background: transparent; }
QLabel#cardCaption { color: #1C1917; font-weight: 700; font-size: 13px; padding: 10px 12px 8px 12px; }
QCheckBox { color: #1C1917; spacing: 8px; font-weight: 600; background: transparent; }
QCheckBox:disabled { color: #A8A29E; }
QCheckBox::indicator, QTreeView::indicator, QgsLayerTreeView::indicator {
  width: 16px;
  height: 16px;
  margin: 2px;
  border: 1.2px solid #A8A29E;
  border-radius: 4px;
  background: #FFFFFF;
}
QCheckBox::indicator:checked, QTreeView::indicator:checked, QgsLayerTreeView::indicator:checked {
  background: #C5E6E1;
  border: 1.2px solid #8FC4BE;
}
QCheckBox::indicator:unchecked, QTreeView::indicator:unchecked, QgsLayerTreeView::indicator:unchecked {
  background: #FFFFFF;
  border: 1.2px solid #A8A29E;
}

QMenu {
  background: #FFFFFF;
  color: #1C1917;
  border: 1px solid #E4DCCE;
  padding: 6px;
}
QMenu::item { color: #1C1917; padding: 8px 16px; min-height: 22px; border-radius: 6px; }
QMenu::item:selected { background: #E7F5F2; color: #1C1917; }
QMenu::item:disabled { color: #A8A29E; }

QStatusBar {
  background: #F6F1E8;
  color: #78716C;
  font-weight: 600;
  border-top: 1px solid #E4DCCE;
}
QStatusBar QLabel { color: #78716C; }

QMenuBar { height: 0px; max-height: 0px; border: none; }

QToolTip {
  color: #1C1917;
  background: #FFFFFF;
  border: 1px solid #E4DCCE;
  padding: 6px 10px;
}

QScrollBar:vertical, QScrollBar:horizontal { background: #F6F1E8; border: none; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
  background: #D6CBB8;
  border: none;
  border-radius: 4px;
  min-height: 24px;
  min-width: 24px;
}

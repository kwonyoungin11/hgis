/* ka-hgis flat chrome — KRDS-inspired. SSOT: hex only; no image functions; no bare QWidget/QGraphicsView/QFrame. */

/* ---- GIS exclude (contract 1). No fill/border color here. ---- */
QgsMapCanvas, QWidget#mapCanvas, QgsLayoutView, QWidget#layoutView {
  background: none;
  border: none;
}

/* ---- Window face ---- */
QMainWindow, QDialog, QMessageBox, QInputDialog, QColorDialog {
  background: #F8FAFC;
  color: #1E293B;
  font-family: "Pretendard GOV", "Pretendard", "Malgun Gothic", "Segoe UI";
  font-size: 13px;
}

/* ---- Push buttons: ghost by default ---- */
QPushButton {
  color: #1E293B;
  font-weight: 600;
  min-height: 34px;
  padding: 8px 16px;
  border: 1px solid #E5E7EB;
  border-radius: 8px;
  background: #FFFFFF;
}
QPushButton:hover { background: #F8FAFC; border-color: #CBD5E1; }
QPushButton:pressed { background: #EFF6FF; }
QPushButton:checked {
  background: #EFF6FF;
  color: #2563EB;
  border-color: #2563EB;
}
QPushButton:default, QPushButton#btnAdjustDone, QPushButton.primary, QPushButton#btnPrimary {
  background: #2563EB;
  color: #FFFFFF;
  border: 1px solid #2563EB;
}
QPushButton:default:hover, QPushButton#btnAdjustDone:hover, QPushButton.primary:hover, QPushButton#btnPrimary:hover {
  background: #1D4ED8;
}
QPushButton:disabled {
  background: #F1F5F9;
  color: #94A3B8;
  border-color: #E5E7EB;
}

/* ---- Tool buttons: ghost ---- */
QToolButton {
  color: #64748B;
  font-weight: 600;
  font-size: 11px;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  padding: 6px 10px;
}
QToolButton:hover { background: #F1F5F9; color: #1E293B; }
QToolButton:pressed { background: #EFF6FF; }
QToolButton:checked {
  background: #EFF6FF;
  color: #2563EB;
  border: 1px solid #BFDBFE;
}
QToolButton:disabled { color: #94A3B8; }
QToolButton#btnPrimary {
  background: #2563EB;
  color: #FFFFFF;
  border: 1px solid #2563EB;
}
QToolButton#btnPrimary:hover { background: #1D4ED8; color: #FFFFFF; }

QToolBar {
  background: #FFFFFF;
  border: none;
  spacing: 8px;
  padding: 8px 12px;
}
QToolBar#mainToolbar, QToolBar#studioToolbar {
  border-bottom: 1px solid #E5E7EB;
}
QToolBar#subToolbar {
  background: #F8FAFC;
  border-top: 1px solid #E5E7EB;
  border-bottom: 1px solid #E5E7EB;
}
QToolBar#mainToolbar QToolButton {
  min-width: 52px;
  min-height: 52px;
  font-size: 11px;
}
QToolBar#studioToolRail {
  background: #FFFFFF;
  spacing: 1px;
  padding: 2px 4px;
  border: none;
  border-left: 1px solid #E5E7EB;
}
QToolBar#studioToolRail QToolButton {
  min-width: 60px;
  min-height: 40px;
  padding: 1px 2px;
  font-size: 10px;
  color: #64748B;
}
QLabel#subToolbarCaption { color: #64748B; font-weight: 600; padding: 0 8px; background: transparent; }

/* ---- Fields ---- */
QLineEdit, QComboBox, QAbstractSpinBox, QTextEdit, QPlainTextEdit {
  background: #FFFFFF;
  color: #1E293B;
  border: 1px solid #E5E7EB;
  border-radius: 8px;
  min-height: 32px;
  padding: 4px 10px;
  selection-background-color: #2563EB;
  selection-color: #FFFFFF;
}
QLineEdit:focus, QComboBox:focus, QAbstractSpinBox:focus {
  border-color: #2563EB;
}
QLineEdit:disabled, QComboBox:disabled, QAbstractSpinBox:disabled {
  background: #F8FAFC;
  color: #94A3B8;
}
QLineEdit#locationSearch { min-height: 34px; min-width: 220px; background: #F8FAFC; }

QAbstractSpinBox { padding-right: 16px; }
QAbstractSpinBox::up-button { width: 16px; }
QComboBox::drop-down {
  subcontrol-origin: border;
  width: 20px;
  border-left: 1px solid #E5E7EB;
}
QComboBox QAbstractItemView, QColorDialog QAbstractSpinBox {
  background: #FFFFFF;
  color: #1E293B;
  selection-background-color: #EFF6FF;
  selection-color: #1E293B;
  min-height: 26px;
  border: 1px solid #E5E7EB;
}

/* ---- Trees / layer list ---- */
QTreeView, QgsLayerTreeView, QListWidget {
  background: #FFFFFF;
  color: #1E293B;
  border: 1px solid #E5E7EB;
  border-radius: 8px;
  outline: none;
  font-size: 13px;
}
QTreeView::item, QgsLayerTreeView::item, QListWidget::item {
  color: #1E293B;
  padding: 5px 6px;
  min-height: 24px;
}
QTreeView::item:selected, QgsLayerTreeView::item:selected, QListWidget::item:selected {
  background: #EFF6FF;
  color: #1E293B;
}
QTreeView::item:hover, QgsLayerTreeView::item:hover, QListWidget::item:hover {
  background: #F8FAFC;
}
QHeaderView::section {
  background: #F8FAFC;
  color: #64748B;
  border: 1px solid #E5E7EB;
  padding: 6px 8px;
}

/* ---- Cards / docks / splitter ---- */
QFrame#mapCard, QFrame#layersCard, QFrame#filesCard,
QFrame#filesInner, QFrame#layersInner,
QFrame#itemInspector, QFrame#mapAdjustBar, QFrame#drawerCard,
QFrame#studioLeftCol, QFrame#studioBottomBar {
  background: #FFFFFF;
  border: 1px solid #E5E7EB;
  border-radius: 10px;
  color: #1E293B;
}
QFrame#studioLeftCol {
  border-radius: 0px;
  border: none;
  border-right: 1px solid #E5E7EB;
  background: #F8FAFC;
}
QFrame#studioBottomBar {
  border-radius: 0px;
  border: none;
  border-top: 1px solid #E5E7EB;
  background: #FFFFFF;
}
QFrame#mapCard { background: #FFFFFF; }
QWidget#sampleStrip {
  background: #FFFFFF;
  border: none;
  border-bottom: 1px solid #E5E7EB;
}
QToolButton.sampleTile {
  min-width: 56px;
  padding: 8px 10px;
}
QLabel#emptyState {
  color: #64748B;
  font-size: 13px;
  padding: 24px 16px;
  background: transparent;
}
QDockWidget { border: 1px solid #E5E7EB; color: #1E293B; titlebar-close-icon: none; }
QDockWidget::title {
  background: #F8FAFC;
  color: #1E293B;
  padding: 8px;
  border-bottom: 1px solid #E5E7EB;
}
QSplitter::handle {
  background: #E5E7EB;
  width: 1px;
  height: 1px;
}

QLabel { color: #1E293B; background: transparent; }
QLabel#cardCaption { color: #1E293B; font-weight: 700; font-size: 13px; padding: 10px 12px 8px 12px; }
QCheckBox { color: #1E293B; spacing: 8px; font-weight: 600; background: transparent; }
QCheckBox:disabled { color: #94A3B8; }
QCheckBox::indicator, QTreeView::indicator, QgsLayerTreeView::indicator {
  width: 14px;
  height: 14px;
}

QMenu {
  background: #FFFFFF;
  color: #1E293B;
  border: 1px solid #E5E7EB;
  padding: 6px;
}
QMenu::item { color: #1E293B; padding: 8px 16px; min-height: 22px; border-radius: 6px; }
QMenu::item:selected { background: #EFF6FF; color: #1E293B; }
QMenu::item:disabled { color: #94A3B8; }

QStatusBar {
  background: #FFFFFF;
  color: #64748B;
  font-weight: 600;
  border-top: 1px solid #E5E7EB;
}
QStatusBar QLabel { color: #64748B; }

QMenuBar { height: 0px; max-height: 0px; border: none; }

QToolTip {
  color: #1E293B;
  background: #FFFFFF;
  border: 1px solid #E5E7EB;
  padding: 6px 10px;
}

QScrollBar:vertical, QScrollBar:horizontal { background: #F8FAFC; border: none; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
  background: #CBD5E1;
  border: none;
  border-radius: 4px;
  min-height: 24px;
  min-width: 24px;
}

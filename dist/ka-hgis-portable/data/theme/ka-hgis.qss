/* ka-hgis field chrome — cool neutral gray + deep blue accent (pro GIS).
   SSOT: hex only; no image functions; no bare QWidget/QGraphicsView/QFrame. */

/* ---- GIS exclude (contract 1). No fill/border color here. ---- */
QgsMapCanvas, QWidget#mapCanvas, QgsLayoutView, QWidget#layoutView {
  background: none;
  border: none;
}

/* ---- Window face ---- */
QMainWindow, QDialog, QMessageBox, QInputDialog, QColorDialog, QDialogButtonBox {
  background: #F2F3F5;
  color: #1F2328;
  font-family: "Malgun Gothic", "Segoe UI";
  font-size: 13px;
}
QWidget#startPage {
  font-family: "Malgun Gothic", "Segoe UI";
  font-size: 13px;
  color: #1F2328;
}
QLabel#recentEmptyHint {
  color: #6E757D;
  font-size: 13px;
  font-family: "Malgun Gothic", "Segoe UI";
}
QWidget#startRail {
  background: #232830;
  color: #EFF2F5;
  font-family: "Malgun Gothic", "Segoe UI";
}
QLabel#startRailHome {
  font-size: 16px;
  font-weight: 800;
  color: #EFF2F5;
  font-family: "Malgun Gothic", "Segoe UI";
}
QWidget#startRail QLabel {
  font-size: 12px;
  color: #A9B1BA;
  font-family: "Malgun Gothic", "Segoe UI";
}
QPushButton#startNewBtn, QPushButton#startOpenBtn {
  font-size: 14px;
  font-weight: 700;
  font-family: "Malgun Gothic", "Segoe UI";
  background: #FFFFFF;
  border: 1px solid #D0D5DD;
  border-bottom: 3px solid #B4BCC8;
  border-radius: 12px;
  color: #1F2328;
  padding: 10px;
}
QPushButton#startNewBtn:hover, QPushButton#startOpenBtn:hover {
  background: #FFFFFF;
  border-color: #1E67C6;
  border-bottom: 3px solid #144E99;
  color: #1E67C6;
}
QPushButton#startNewBtn:pressed, QPushButton#startOpenBtn:pressed {
  background: #EDF2F7;
  border-bottom: 1px solid #B4BCC8;
  margin-top: 2px;
}
QDialogButtonBox QPushButton {
  font-size: 13px;
  min-height: 34px;
  font-family: "Malgun Gothic", "Segoe UI";
}
QMessageBox QLabel, QInputDialog QLabel {
  font-size: 13px;
  color: #1F2328;
  font-family: "Malgun Gothic", "Segoe UI";
}

/* ---- Push buttons ---- */
QPushButton {
  color: #1F2328;
  font-weight: 600;
  min-height: 34px;
  padding: 8px 16px;
  border: 1px solid #D5D9DE;
  border-bottom: 2px solid #BAC2CC;
  border-radius: 8px;
  background: #FFFFFF;
}
QPushButton:hover { background: #F8F9FA; border-color: #C3C8CF; border-bottom: 2px solid #ACB5C0; }
QPushButton:pressed { background: #E8F0FA; border-bottom: 1px solid #BAC2CC; margin-top: 1px; min-height: 33px; }
QPushButton:checked {
  background: #E8F0FA;
  color: #124B94;
  border-color: #1E67C6;
  border-bottom: 2px solid #17529E;
}
QPushButton:default, QPushButton#btnAdjustDone, QPushButton.primary, QPushButton#btnPrimary {
  background: #1E67C6;
  color: #FFFFFF;
  border: 1px solid #1E67C6;
  border-bottom: 2px solid #144E99;
}
QPushButton:default:hover, QPushButton#btnAdjustDone:hover, QPushButton.primary:hover, QPushButton#btnPrimary:hover {
  background: #175AB0;
  border-bottom: 2px solid #103E7A;
}
QPushButton:disabled {
  background: #E9EBEE;
  color: #A5ABB3;
  border-color: #D5D9DE;
}

/* ---- Tool buttons ---- */
QToolButton {
  color: #575E66;
  font-weight: 600;
  font-size: 12px;
  border: 2px solid transparent;
  border-radius: 0;
  background: transparent;
  padding: 6px 10px;
}
QToolButton:hover { background: #F2F3F5; color: #1F2328; }
QToolButton:pressed { background: #E9EBEE; }
QToolButton:checked {
  background: transparent;
  color: #124B94;
  border: 2px solid transparent;
  border-bottom: 2px solid #1E67C6;
  font-weight: 700;
}
QToolButton:checked:hover {
  background: #F2F3F5;
  color: #124B94;
  border: 2px solid transparent;
  border-bottom: 2px solid #175AB0;
}
QToolButton:disabled { color: #A5ABB3; }
QToolButton#btnPrimary {
  background: transparent;
  color: #124B94;
  border: 2px solid transparent;
}
QToolButton#btnPrimary:hover {
  background: #F2F3F5;
  color: #1F2328;
  border: 2px solid transparent;
}
QToolButton#btnPrimary:pressed { background: #E9EBEE; }
QToolButton#btnPrimary:checked {
  background: transparent;
  color: #124B94;
  border: 2px solid transparent;
  border-bottom: 2px solid #1E67C6;
}

QToolBar {
  background: #FFFFFF;
  border: none;
  spacing: 1px;
  padding: 4px 8px;
}
QToolBar::separator {
  background: #D5D9DE;
  width: 1px;
  margin: 8px 4px;
}
QToolBar#mainToolbar::separator {
  background: #C3C8CF;
  width: 1px;
  margin: 10px 8px;
}
QToolBar#mainToolbar, QToolBar#studioToolbar {
  border-bottom: 1px solid #D5D9DE;
}
QToolBar#studioToolbar QToolButton {
  min-height: 36px;
  padding: 6px 10px;
  font-size: 12px;
  color: #4C535B;
}
QToolBar#subToolbar {
  background: #FBFCFD;
  border-top: 1px solid #D5D9DE;
  border-bottom: 1px solid #D5D9DE;
}
QToolBar#subToolbar QToolButton:checked {
  background: transparent;
  color: #124B94;
  border: 2px solid transparent;
  border-bottom: 2px solid #1E67C6;
}
QToolBar#mainToolbar {
  spacing: 2px;
  padding: 4px 8px;
}
QToolBar#mainToolbar QToolButton {
  min-width: 58px;
  min-height: 58px;
  padding: 3px 5px;
  font-size: 11px;
  background: transparent;
  border: 2px solid transparent;
  border-radius: 0;
}
QToolBar#mainToolbar QToolButton:hover {
  background: #F2F3F5;
  border: 2px solid transparent;
}
QToolBar#mainToolbar QToolButton:pressed { background: #E9EBEE; }
QToolBar#mainToolbar QToolButton::menu-indicator {
  image: none;
  width: 0px;
}
QToolBar#mainToolbar QToolButton:checked {
  background: transparent;
  color: #124B94;
  border: 2px solid transparent;
  border-bottom: 2px solid #1E67C6;
}
QToolBar#mainToolbar QToolButton:checked:hover {
  background: #F2F3F5;
  color: #124B94;
  border: 2px solid transparent;
  border-bottom: 2px solid #175AB0;
}
QWidget#beginnerRibbon {
  background: transparent;
}
QFrame#ribbonGroup {
  background: transparent;
  border: none;
  border-right: 1px solid #D5D9DE;
}
QLabel#ribbonGroupCaption {
  color: #6E757D;
  font-size: 11px;
  font-weight: 600;
  min-height: 18px;
  padding: 0 2px;
  background: transparent;
}
QWidget#beginnerRibbon QToolButton {
  min-width: 62px;
  min-height: 58px;
  margin: 2px 1px;
  padding: 3px 2px;
  background: #FFFFFF;
  color: #1F2328;
  font-size: 11px;
  border: 1px solid #D5D9DE;
  border-bottom: 2px solid #BAC2CC;
  border-radius: 8px;
  text-align: center;
}
QWidget#beginnerRibbon QToolButton:hover {
  background: #F8FAFC;
  border-color: #A0AAB5;
  border-bottom: 2px solid #8E98A5;
}
QWidget#beginnerRibbon QToolButton:pressed {
  background: #EEF2F6;
  border-bottom: 1px solid #BAC2CC;
  margin-top: 3px;
  min-height: 57px;
}
QWidget#beginnerRibbon QToolButton:checked {
  background: #FFFFFF;
  color: #124B94;
  border: 1px solid #1E67C6;
  border-bottom: 2px solid #124B94;
  border-radius: 8px;
}
QWidget#beginnerRibbon QToolButton::menu-button {
  border: none;
  background: transparent;
  width: 0px;
}
QWidget#beginnerRibbon QToolButton::menu-arrow {
  image: none;
  width: 0px;
  height: 0px;
}
QWidget#beginnerRibbon QToolButton::menu-indicator {
  image: none;
  width: 0px;
  height: 0px;
}
QWidget#regionLocator {
  min-height: 72px;
  min-width: 230px;
  background: transparent;
  border: none;
}
QWidget#regionLocator QToolButton#regionChip {
  min-width: 32px;
  max-width: 38px;
  min-height: 22px;
  max-height: 22px;
  margin: 1px;
  padding: 0 2px;
  font-size: 11px;
  font-weight: 700;
  color: #1B3A6B;
  background: #FFFFFF;
  border: 1px solid #D5D9DE;
  border-radius: 6px;
}
QWidget#regionLocator QToolButton#regionChip:hover {
  background: #E8F1FC;
  border-color: #1E67C6;
}
QWidget#regionLocator QToolButton#regionChip:checked {
  background: #FFFFFF;
  color: #124B94;
  border: 1px solid #1E67C6;
  border-radius: 8px;
}
QToolBar#studioToolRail {
  background: #FBFCFD;
  spacing: 1px;
  padding: 2px 4px;
  border: none;
  border-left: 1px solid #D5D9DE;
}
QToolBar#studioToolRail QToolButton {
  min-width: 60px;
  min-height: 40px;
  padding: 1px 2px;
  font-size: 12px;
  color: #575E66;
}
QLabel#subToolbarCaption { color: #6E757D; font-weight: 600; padding: 0 8px; background: transparent; }

/* ---- Fields ---- */
QLineEdit, QComboBox, QAbstractSpinBox, QTextEdit, QPlainTextEdit {
  background: #FFFFFF;
  color: #1F2328;
  border: 1px solid #D5D9DE;
  border-radius: 8px;
  min-height: 32px;
  padding: 4px 10px;
  selection-background-color: #1E67C6;
  selection-color: #FFFFFF;
}
QLineEdit:focus, QComboBox:focus, QAbstractSpinBox:focus {
  border-color: #1E67C6;
}
QLineEdit:disabled, QComboBox:disabled, QAbstractSpinBox:disabled {
  background: #F2F3F5;
  color: #A5ABB3;
}
QToolBar#mainToolbar QToolButton#regionChip {
  min-width: 32px;
  max-width: 38px;
  min-height: 22px;
  max-height: 22px;
  margin: 1px;
  padding: 0 2px;
  font-size: 11px;
  font-weight: 700;
  color: #1B3A6B;
  background: #FFFFFF;
  border: 1px solid #D5D9DE;
  border-radius: 6px;
}
QToolBar#mainToolbar QToolButton#regionChip:hover { background: #E8F1FC; border-color: #1E67C6; }
QToolBar#mainToolbar QToolButton#regionChip:checked {
  background: #FFFFFF;
  color: #124B94;
  border: 1px solid #D5D9DE;
  border-bottom: 2px solid #1E67C6;
}
QFrame#regionAddressPopup {
  background: #FFFFFF;
  border: 1px solid #9DBBE8;
  border-radius: 10px;
}
QLabel#regionSidoTitle { color: #1B3A6B; font-weight: 700; }

QAbstractSpinBox { padding-right: 16px; }
QAbstractSpinBox::up-button { width: 16px; }
QComboBox::drop-down {
  subcontrol-origin: border;
  width: 20px;
  border-left: 1px solid #D5D9DE;
}
QComboBox QAbstractItemView, QColorDialog QAbstractSpinBox {
  background: #FFFFFF;
  color: #1F2328;
  selection-background-color: #E8F0FA;
  selection-color: #1F2328;
  min-height: 26px;
  border: 1px solid #D5D9DE;
}

/* ---- Trees / layer list ---- */
QTreeView, QgsLayerTreeView, QListWidget, QTableWidget, QTableView {
  background: #FBFCFD;
  color: #1F2328;
  border: 1px solid #D5D9DE;
  border-radius: 8px;
  outline: none;
  font-size: 13px;
  font-family: "Malgun Gothic", "Segoe UI";
}
QTreeView::item, QgsLayerTreeView::item, QListWidget::item, QTableWidget::item, QTableView::item {
  color: #1F2328;
  padding: 5px 6px;
  min-height: 24px;
}
QTreeView::item:selected, QgsLayerTreeView::item:selected, QListWidget::item:selected,
QTableWidget::item:selected, QTableView::item:selected {
  background: #E2E6EA;
  color: #1F2328;
}
QTreeView::item:hover, QgsLayerTreeView::item:hover, QListWidget::item:hover,
QTableWidget::item:hover, QTableView::item:hover {
  background: #E9EBEE;
}
QHeaderView::section {
  background: #F2F3F5;
  color: #6E757D;
  border: 1px solid #D5D9DE;
  padding: 6px 8px;
}

/* ---- Cards / docks / splitter ---- */
QFrame#mapCard, QFrame#layersCard, QFrame#filesCard,
QFrame#itemInspector, QFrame#mapAdjustBar, QFrame#drawerCard,
QFrame#studioLeftCol, QFrame#studioBottomBar,
QFrame#terrainLayersCard, QFrame#terrainFilesCard {
  background: #FFFFFF;
  border: 1px solid #D5D9DE;
  border-bottom: 2px solid #BAC2CC;
  border-right: 1.5px solid #C5CDD7;
  border-radius: 10px;
  color: #1F2328;
}
QFrame#filesInner, QFrame#layersInner {
  background: #F8F9FA;
  border: 1px solid #DFE2E6;
  border-radius: 8px;
  color: #1F2328;
}
QFrame#studioLeftCol {
  border-radius: 0px;
  border: none;
  border-right: 1px solid #D5D9DE;
  background: #F2F3F5;
}
QWidget#terrain3dPanel {
  background: #F2F3F5;
  border-right: 1px solid #D5D9DE;
}
QFrame#studioBottomBar {
  border-radius: 0px;
  border: none;
  border-top: 1px solid #D5D9DE;
  background: #FFFFFF;
}
QFrame#mapCard { background: #FFFFFF; }
QWidget#sampleStrip {
  background: #FFFFFF;
  border: none;
  border-bottom: 1px solid #D5D9DE;
}
QToolButton.sampleTile {
  min-width: 56px;
  min-height: 54px;
  padding: 4px 6px;
  font-size: 11px;
  font-weight: 600;
  color: #1F2328;
  background: #FFFFFF;
  border: 1px solid #D5D9DE;
  border-radius: 8px;
}
QToolButton.sampleTile:hover {
  background: #E9EBEE;
  border-color: #C3C8CF;
  color: #1F2328;
}
QToolButton.sampleTile:checked {
  background: #E8F0FA;
  color: #124B94;
  border: 1px solid #1E67C6;
}
QToolButton.sampleTile:checked:hover {
  background: #E8F0FA;
  color: #124B94;
  border-color: #175AB0;
}
QToolButton#scaleChip {
  min-width: 56px;
  min-height: 36px;
  font-size: 12px;
  font-weight: 700;
  color: #1F2328;
  background: #FFFFFF;
  border: 1px solid #D5D9DE;
  border-radius: 8px;
}
QToolButton#scaleChip:checked {
  background: #E8F0FA;
  color: #124B94;
  border: 1px solid #1E67C6;
}
QLabel#emptyState {
  color: #6E757D;
  font-size: 13px;
  font-weight: 500;
  padding: 24px 16px;
  min-height: 88px;
  background: #FFFFFF;
  border: 1px dashed #D5D9DE;
  border-radius: 8px;
}
/* ---- View tabs (홈/지도) ---- */
QTabWidget::pane { border: none; }
QTabBar { background: transparent; font-weight: 600; }
QTabBar::tab {
  background: transparent;
  color: #6E757D;
  padding: 7px 16px;
  border: none;
  border-bottom: 2px solid transparent;
  margin: 0 2px;
}
QTabBar::tab:selected { color: #124B94; border-bottom: 2px solid #1E67C6; }
/* ---- Left Dock (레이어 위 / 파일함 아래 동시 노출) ---- */
QSplitter#leftSplit {
  background: transparent;
}
QSplitter#leftSplit::handle {
  background: #D5D9DE;
  height: 6px;
  margin: 2px 12px;
  border-radius: 3px;
}
QSplitter#leftSplit::handle:hover {
  background: #1E67C6;
}
QFrame#layersCard,
QFrame#filesCard {
  background: #FFFFFF;
  border: 1px solid #D5D9DE;
  border-bottom: 2px solid #BAC2CC;
  border-right: 1.5px solid #C5CDD7;
  border-radius: 8px;
}
QFrame#layersInner,
QFrame#filesInner {
  background: #F8F9FA;
  border: 1px solid #DFE2E6;
  border-radius: 6px;
}

/* ---- Side panel buttons (레이어·파일함) ---- */
QFrame#layersCard QToolButton, QFrame#filesCard QToolButton {
  font-size: 12px;
  padding: 4px 10px;
  border: 1px solid #D5D9DE;
  border-bottom: 2px solid #BAC2CC;
  background: #FFFFFF;
  border-radius: 6px;
  color: #4C535B;
}
QFrame#layersCard QToolButton:hover, QFrame#filesCard QToolButton:hover {
  background: #F8FAFC;
  border-color: #C3C8CF;
  border-bottom: 2px solid #ACB5C0;
  color: #1F2328;
}
QFrame#layersCard QToolButton:pressed, QFrame#filesCard QToolButton:pressed {
  background: #E8F0FA;
  border-bottom: 1px solid #BAC2CC;
}

QDockWidget { border: 1px solid #D5D9DE; color: #1F2328; titlebar-close-icon: none; }
QDockWidget::title {
  background: #F2F3F5;
  color: #1F2328;
  padding: 8px;
  border-bottom: 1px solid #D5D9DE;
}
QSplitter::handle {
  background: #D5D9DE;
  width: 1px;
  height: 1px;
}
/* 왼쪽 패널 ↔ 지도 경계는 손으로 끌어야 한다. 1px 손잡이는 잡히지 않는다. */
QSplitter#mainSplit::handle:horizontal {
  background: #E6E9ED;
  width: 7px;
  border-left: 1px solid #D5D9DE;
  border-right: 1px solid #D5D9DE;
}
QSplitter#mainSplit::handle:horizontal:hover { background: #9CB6D8; }

QLabel { color: #1F2328; background: transparent; }
QLabel#cardCaption { color: #6E757D; font-weight: 700; font-size: 12px; padding: 2px 2px 0 2px; }
QCheckBox { color: #1F2328; spacing: 8px; font-weight: 600; background: transparent; }
QCheckBox:disabled { color: #A5ABB3; }
QCheckBox::indicator, QTreeView::indicator, QgsLayerTreeView::indicator {
  width: 16px;
  height: 16px;
  margin: 2px;
  border: 1.2px solid #A5ABB3;
  border-radius: 4px;
  background: #FFFFFF;
}
QCheckBox::indicator:checked, QTreeView::indicator:checked, QgsLayerTreeView::indicator:checked {
  background: #1E67C6;
  border: 1.2px solid #1E67C6;
}
QCheckBox::indicator:unchecked, QTreeView::indicator:unchecked, QgsLayerTreeView::indicator:unchecked {
  background: #FFFFFF;
  border: 1.2px solid #A5ABB3;
}

QMenu {
  background: #FFFFFF;
  color: #1F2328;
  border: 1px solid #D5D9DE;
  padding: 6px;
  font-family: "Malgun Gothic", "Segoe UI";
  font-size: 13px;
}
QMenu::item { color: #1F2328; padding: 8px 16px; min-height: 22px; border-radius: 6px; }
QMenu::item:selected { background: #E8F0FA; color: #1F2328; }
QMenu::item:disabled { color: #A5ABB3; }

QStatusBar {
  background: #F2F3F5;
  color: #6E757D;
  font-weight: 600;
  border-top: 1px solid #D5D9DE;
}
QStatusBar QLabel { color: #6E757D; }

/* ---- Status bar instrument panel ---- */
QStatusBar#kaStatusBar {
  background: #FBFCFD;
  color: #575E66;
  min-height: 34px;
  padding: 0 6px;
}
QStatusBar::item { border: none; }
QFrame#statusSep { background: #D5D9DE; border: none; margin: 7px 3px; }
QLabel#xyReadout {
  color: #1F2328;
  font-family: "Consolas", "D2Coding", "Malgun Gothic";
  font-size: 12px;
  padding: 0 8px;
}
QLabel#scaleLabel { color: #6E757D; padding-left: 4px; }
QStatusBar#kaStatusBar QLineEdit#scaleEdit,
QStatusBar#kaStatusBar QComboBox#scaleCombo {
  min-height: 24px;
  padding: 2px 8px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
}
QToolButton#crsButton {
  color: #124B94;
  background: #E8F0FA;
  border: 1px solid #C9DCF2;
  border-radius: 6px;
  padding: 4px 10px;
  font-size: 12px;
}
QToolButton#crsButton:hover { background: #DCE9F8; border-color: #1E67C6; }
QLabel#uploadCrsChip {
  color: #3E6B4A;
  background: #EAF2EC;
  border: 1px solid #CCDED2;
  border-radius: 6px;
  padding: 4px 10px;
  font-size: 12px;
}
QToolButton#renderToggle {
  color: #124B94;
  border: 1px solid transparent;
  border-radius: 6px;
  padding: 4px 10px;
  font-size: 12px;
}
QToolButton#renderToggle:checked {
  background: #E8F0FA;
  color: #124B94;
  border: 1px solid #C9DCF2;
}
QToolButton#renderToggle:!checked {
  color: #A33A2E;
  background: #F9E9E5;
  border: 1px solid #EBC6C1;
}
QToolButton#renderToggle:hover { background: #DCE9F8; color: #124B94; }

QMenuBar { height: 0px; max-height: 0px; border: none; }

QToolTip {
  color: #1F2328;
  background: #FFFFFF;
  border: 1px solid #D5D9DE;
  padding: 6px 10px;
  font-family: "Malgun Gothic", "Segoe UI";
  font-size: 13px;
}

QScrollBar:vertical, QScrollBar:horizontal { background: #F2F3F5; border: none; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
  background: #C3C8CF;
  border: none;
  border-radius: 4px;
  min-height: 24px;
  min-width: 24px;
}
